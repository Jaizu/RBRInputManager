<ui:FluentWindow x:Class="RBRInputManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:RBRInputManager"
        Title="RBR Input Manager" Height="840" Width="1240" MinWidth="880" MinHeight="560"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen" Icon="Assets/RBRInputManager.ico">
    <ui:FluentWindow.Resources>
        <!-- Device name with a status dot (green connected, orange seen this month, red missing); hover for details,
             shown under the dot rather than past the end of the name. -->
        <DataTemplate x:Key="DeviceCell">
            <StackPanel x:Name="Cell" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent"
                        ToolTip="{Binding Status}" ToolTipService.PlacementTarget="{Binding ElementName=Dot}"
                        local:TooltipPlacement.Prefer="Bottom">
                <Ellipse x:Name="Dot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                         Fill="{DynamicResource SystemFillColorSuccessBrush}"/>
                <TextBlock Text="{Binding Device}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Recent">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Missing">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="None">
                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Cell" Property="ToolTipService.IsEnabled" Value="False"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <CubicEase x:Key="Ease" EasingMode="EaseInOut"/>

        <!--
            WPF-UI's button template sets Foreground to black while pressed (it ignores PressedForeground).
            Style triggers take precedence over template triggers, so this keeps the text readable.
        -->
        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsPressed" Value="True"/>
                        <Condition Property="Appearance" Value="Primary"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Surface layers, darkest to lightest (same as the Windows 11 flyouts):
            Mica window → section card (CardBackground) → card header strip (CardBackgroundSecondary).
            The status bar sits on LayerOnMicaBaseAlt; column headers and categories on subtle fills.
        -->

        <!-- Clickable header strip of a section card; the chevron turns when collapsed. -->
        <Style x:Key="SectionToggle" TargetType="ToggleButton">
            <Setter Property="IsChecked" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="8,8,0,0" BorderThickness="0,0,0,1"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                            <Border x:Name="Hover" CornerRadius="{Binding CornerRadius, ElementName=Bd}" Padding="16,11"
                                    Background="Transparent">
                                <DockPanel>
                                    <ui:SymbolIcon x:Name="Chevron" DockPanel.Dock="Right" Symbol="ChevronDown24" FontSize="14"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <ui:SymbolIcon.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </ui:SymbolIcon.RenderTransform>
                                    </ui:SymbolIcon>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Bd" Property="CornerRadius" Value="8"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Chevron" To="-90" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource Ease}"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Chevron" To="0" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource Ease}"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Collapsible section card: header toggles the body, which folds with a height + fade animation. -->
        <Style x:Key="Section" TargetType="HeaderedContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="4,2,4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <DockPanel>
                                <ToggleButton x:Name="Toggle" DockPanel.Dock="Top" Style="{StaticResource SectionToggle}"
                                              Content="{TemplateBinding Header}"/>
                                <ContentPresenter x:Name="Body" Margin="{TemplateBinding Padding}">
                                    <ContentPresenter.LayoutTransform>
                                        <ScaleTransform ScaleY="1"/>
                                    </ContentPresenter.LayoutTransform>
                                </ContentPresenter>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Toggle" Property="IsChecked" Value="False">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Body" To="0" Duration="0:0:0.22"
                                                             EasingFunction="{StaticResource Ease}"
                                                             Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)"/>
                                            <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Body" To="1" Duration="0:0:0.22"
                                                             EasingFunction="{StaticResource Ease}"
                                                             Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)"/>
                                            <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity"
                                                             To="1" BeginTime="0:0:0.05" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <!-- Section card headers: upper case (written so in the text) in the HUD font, like the tabs. -->
        <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="FontFamily" Value="{StaticResource HudFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="SectionIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <!-- Small pill with a count, on the right of section headers. -->
        <!-- Small "(n items)" note right after a section heading -->
        <Style x:Key="SectionCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="8,1,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>

        <!-- Small accent caption above groups of cards (Settings). -->
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="2,14,0,8"/>
        </Style>

        <!-- Left gripper: the half of a column edge that lies in the next header. It resizes the previous
             column, so it lights the same accent line on its side of the edge (no line at rest). -->
        <Style x:Key="HeaderGripper" TargetType="Thumb">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Rectangle x:Name="Line" Width="2" Height="16" HorizontalAlignment="Left" Fill="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Line" Property="Height" Value="32"/>
                                <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right gripper draws a divider so resizable column edges are visible;
             WPF collapses it when the column can't be resized. -->
        <Style x:Key="HeaderGripperRight" TargetType="Thumb" BasedOn="{StaticResource HeaderGripper}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Rectangle x:Name="Line" Width="1" Height="16" HorizontalAlignment="Right"
                                       Fill="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Width" Value="2"/>
                                <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Line" Property="Width" Value="2"/>
                                <Setter TargetName="Line" Property="Height" Value="32"/>
                                <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <!-- Extra 3px on the left matches GridCell, leaving room for the selection pill -->
            <Setter Property="Padding" Value="11,0,8,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <!-- Square header cells; the grippers keep column resizing working -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource HeaderGripper}"/>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource HeaderGripperRight}"/>
                        </Grid>
                        <!-- WPF owns the grippers' Visibility, so dead edges are hidden by hit testing and opacity -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="NoRightEdge">
                                <Setter TargetName="PART_RightHeaderGripper" Property="IsHitTestVisible" Value="False"/>
                                <Setter TargetName="PART_RightHeaderGripper" Property="Opacity" Value="0"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="NoLeftEdge">
                                <Setter TargetName="PART_LeftHeaderGripper" Property="IsHitTestVisible" Value="False"/>
                                <Setter TargetName="PART_LeftHeaderGripper" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            WPF resizes a column by taking (or giving) width from the columns to its RIGHT: first the star
            column, then resizable fixed ones (squeezing them to 20px). A star column marked CanUserResize="False"
            is skipped, which made every drag squeeze the fixed column next to it. So each grid keeps one
            resizable star column that every edge to its left can use, and edges that can't move anything
            (a star column's own right edge with only fixed columns after it) are hidden with these styles.
        -->
        <Style x:Key="HeaderNoRightEdge" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeader}">
            <Setter Property="Tag" Value="NoRightEdge"/>
        </Style>
        <Style x:Key="HeaderNoLeftEdge" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeader}">
            <Setter Property="Tag" Value="NoLeftEdge"/>
        </Style>

        <!-- WPF-UI's row template puts the selection pill in its own Auto column, so showing it
             shoves every cell 3px right. Same template, but the pill overlays the cells instead. -->
        <Style x:Key="GridRow" TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="DGR_Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </SelectiveScrollingGrid.ColumnDefinitions>
                                <SelectiveScrollingGrid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </SelectiveScrollingGrid.RowDefinitions>
                                <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <DataGridDetailsPresenter Grid.Row="1" Grid.Column="1" Visibility="{TemplateBinding DetailsVisibility}"/>
                                <Rectangle x:Name="ActiveRectangle" Grid.ColumnSpan="2" Width="3" Height="18"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource ListViewItemPillFillBrush}" Visibility="Collapsed"
                                           IsHitTestVisible="False"/>
                            </SelectiveScrollingGrid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="AlternationIndex" Value="0">
                                <Setter TargetName="DGR_Border" Property="Background" Value="{Binding RowBackground, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </Trigger>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter TargetName="DGR_Border" Property="Background" Value="{Binding AlternatingRowBackground, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default 6px left padding plus the pill's 3px, so selected text never touches the pill -->
        <Style x:Key="GridCell" TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
            <Setter Property="Padding" Value="9,0,6,0"/>
        </Style>

        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="RowStyle" Value="{StaticResource GridRow}"/>
            <Setter Property="CellStyle" Value="{StaticResource GridCell}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <!-- Cancel the section body padding so the header bar runs edge to edge -->
            <Setter Property="Margin" Value="-4,-2,-4,0"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ColumnHeader}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="BindingRow" TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnbound}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                </DataTrigger>
                <!-- Unsaved edit -->
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Small icon buttons inside table rows. -->
        <Style x:Key="RowButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Bind / Add another / Clear for a game action. Add and Clear only make sense when bound. -->
        <DataTemplate x:Key="GameEditCell">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button Style="{StaticResource RowButton}" Content="Bind" Icon="{ui:SymbolIcon Edit20}" Click="BindAction_Click"
                           ToolTip="Replace this binding: press a button or move an axis"/>
                <ui:Button x:Name="AddBtn" Style="{StaticResource RowButton}" Icon="{ui:SymbolIcon Add20}" Click="AddAction_Click"
                           ToolTip="Add another binding for this action"/>
                <ui:Button x:Name="ClearBtn" Style="{StaticResource RowButton}" Icon="{ui:SymbolIcon Dismiss20}" Click="ClearAction_Click"
                           ToolTip="Remove this binding"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUnbound}" Value="True">
                    <Setter TargetName="AddBtn" Property="Visibility" Value="Hidden"/>
                    <Setter TargetName="ClearBtn" Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- RBR keeps one invert flag per axis action in input.ini, shared by every map and binding. -->
        <DataTemplate x:Key="InvertCell">
            <CheckBox x:Name="Box" IsChecked="{Binding Inverted, Mode=OneWay}" Click="InvertAction_Click" MinWidth="0"
                      VerticalAlignment="Center" ToolTip="Invert this axis in RBR (input.ini). Applies to every map"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Inverted}" Value="{x:Null}">
                    <Setter TargetName="Box" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PluginEditCell">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button Style="{StaticResource RowButton}" Content="Bind" Icon="{ui:SymbolIcon Edit20}" Click="BindPlugin_Click"
                           ToolTip="Press a button or key to bind"/>
                <ui:Button x:Name="ClearBtn" Style="{StaticResource RowButton}" Icon="{ui:SymbolIcon Dismiss20}" Click="ClearPlugin_Click"
                           ToolTip="Remove this bind"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUnbound}" Value="True">
                    <Setter TargetName="ClearBtn" Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SettingRow" TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Differs}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Category toggle inside grids: accent bar + accent name + count + chevron. -->
        <Style x:Key="GroupToggle" TargetType="ToggleButton">
            <Setter Property="IsChecked" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Margin="0,8,0,2" Padding="10,6" CornerRadius="4"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                            <DockPanel>
                                <ui:SymbolIcon x:Name="Chevron" DockPanel.Dock="Right" Symbol="ChevronDown24" FontSize="12"
                                               VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <ui:SymbolIcon.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </ui:SymbolIcon.RenderTransform>
                                </ui:SymbolIcon>
                                <Border Width="3" CornerRadius="1.5" Margin="0,1,10,1"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Text="{Binding ItemCount}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Chevron" To="-90" Duration="0:0:0.18"
                                                             EasingFunction="{StaticResource Ease}"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Chevron" To="0" Duration="0:0:0.18"
                                                             EasingFunction="{StaticResource Ease}"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <GroupStyle x:Key="Groups">
            <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GroupItem">
                                <StackPanel>
                                    <ToggleButton x:Name="Toggle" Style="{StaticResource GroupToggle}"/>
                                    <ItemsPresenter x:Name="Items">
                                        <ItemsPresenter.LayoutTransform>
                                            <ScaleTransform ScaleY="1"/>
                                        </ItemsPresenter.LayoutTransform>
                                    </ItemsPresenter>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger SourceName="Toggle" Property="IsChecked" Value="False">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Items" To="0" Duration="0:0:0.2"
                                                                     EasingFunction="{StaticResource Ease}"
                                                                     Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)"/>
                                                    <DoubleAnimation Storyboard.TargetName="Items" Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.14"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Items" To="1" Duration="0:0:0.2"
                                                                     EasingFunction="{StaticResource Ease}"
                                                                     Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)"/>
                                                    <DoubleAnimation Storyboard.TargetName="Items" Storyboard.TargetProperty="Opacity"
                                                                     To="1" BeginTime="0:0:0.05" Duration="0:0:0.18"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupStyle.ContainerStyle>
        </GroupStyle>

        <!-- Inline notice inside a card (caution / success / info). -->
        <Style x:Key="Notice" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="8,8,8,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
        </Style>
        <!-- Full-width informational banner at the top of a section body; the negative margin cancels the section padding. -->
        <Style x:Key="InfoBanner" TargetType="Border">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="-4,-2,-4,0"/>
            <Setter Property="Background" Value="#403D8BE0"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="CardText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Page" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="0,12,6,0"/>
        </Style>
        <!-- In-game strength bar: red fill up to the value, white knob. -->
        <Style x:Key="StrengthBarPart" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StrengthBar" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="20">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource StrengthBarPart}"
                                              Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource StrengthBarPart}"
                                              Background="{DynamicResource ControlStrongFillColorDefaultBrush}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="16" Height="16" Fill="White"
                                                     Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Page switcher: the tab headers drawn as separate buttons in the input display's HUD colours. -->
        <Style x:Key="HudTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <StackPanel Orientation="Horizontal" IsItemsHost="True" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="TabItem">
                        <Setter Property="Margin" Value="0,0,8,0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <!-- Headers inherit from the TabItem (their logical parent), so colours are set here. -->
                        <Setter Property="Foreground" Value="#C8FFFFFF"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Chip" Background="#E0383838" BorderBrush="#30FFFFFF" BorderThickness="2"
                                            CornerRadius="3" Padding="14,8">
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="#E0464646"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="#E0505050"/>
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="RBR Input Manager">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Width="22" Height="16">
                    <ui:ImageIcon.Source>
                        <DrawingImage>
                            <DrawingImage.Drawing>
                                <GeometryDrawing Geometry="{StaticResource LogoGeometry}" Brush="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </DrawingImage.Drawing>
                        </DrawingImage>
                    </ui:ImageIcon.Source>
                </ui:ImageIcon>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Update banner -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" Margin="16,4,16,0" Padding="16,10"
                CornerRadius="8" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button x:Name="InstallUpdateButton" Content="Update and restart" Appearance="Primary"
                               Icon="{ui:SymbolIcon ArrowDownload24}" Click="InstallUpdate_Click"/>
                    <ui:Button Content="Later" Margin="8,0,0,0" Click="DismissUpdate_Click"/>
                </StackPanel>
                <ui:SymbolIcon Symbol="ArrowCircleUp24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </DockPanel>
        </Border>

        <!-- Install summary card -->
        <Border Grid.Row="2" Margin="16,8,16,0" Padding="14,10" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <DockPanel>
                <!-- Profile selector, styled like SimHub's: accent bar · "Current" · profile picker · state · apply · Profiles. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="6" Padding="0,4,4,4" VerticalAlignment="Center"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="3" Margin="8,4,10,4" CornerRadius="1.5"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <TextBlock Text="Current" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Grid>
                                <ComboBox x:Name="CurrentProfileBox" Width="240" VerticalAlignment="Center"
                                          SelectionChanged="CurrentProfile_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="26" Height="26" CornerRadius="5" Margin="0,0,10,0"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                    <ui:SymbolIcon Symbol="XboxController24" FontSize="15"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock x:Name="NoProfileText" Text="No profile" IsHitTestVisible="False"
                                           Margin="14,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </Grid>
                            <!-- Whether the game files still hold the selected profile. -->
                            <Border x:Name="ProfileStateHost" Margin="8,0,4,0" Background="Transparent" VerticalAlignment="Center"
                                    MouseLeftButtonUp="ProfileState_Click">
                                <ui:SymbolIcon x:Name="ProfileStateIcon" Symbol="CheckmarkCircle24" FontSize="18"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- The tooltip sits on a wrapper: a disabled button shows none, and this one is disabled most of the time. -->
                    <Border x:Name="ApplyCurrentHost" Margin="8,0,0,0" Background="Transparent">
                        <ui:Button x:Name="ApplyCurrentButton" Content="Apply" Appearance="Primary" Padding="12,7" IsEnabled="False"
                                   Icon="{ui:SymbolIcon Play24}" Click="ApplyCurrentProfile_Click"/>
                    </Border>
                    <ui:Button x:Name="ReloadButton" Margin="6,0,0,0" Padding="9,7" Click="Reload_Click"
                               ToolTip="Reload: read the bindings and controllers again from the game files">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" RenderTransformOrigin="0.5,0.5">
                            <ui:SymbolIcon.RenderTransform>
                                <RotateTransform x:Name="ReloadRotate" Angle="0"/>
                            </ui:SymbolIcon.RenderTransform>
                        </ui:SymbolIcon>
                    </ui:Button>
                    <ui:Button Content="Profiles" Margin="6,0,0,0" Padding="14,7" Click="OpenProfiles_Click"
                               ToolTip="Save, apply and manage input profiles"/>
                </StackPanel>
                <Path Data="{StaticResource LogoGeometry}" Fill="{DynamicResource TextFillColorPrimaryBrush}"
                      Stretch="Uniform" Width="56" Height="42" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="InstallText" Style="{StaticResource SectionTitle}" FontSize="14"/>
                    <TextBlock x:Name="InstallSubText" Style="{StaticResource CardText}" Margin="0,1,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tab headers only; the pages below stay built so switching is instant and keeps their state. -->
        <DockPanel Grid.Row="3" Margin="16,10,16,0">
        <Grid DockPanel.Dock="Top">
        <TabControl x:Name="Tabs" Style="{StaticResource HudTabs}" SelectionChanged="Tabs_SelectionChanged">
            <!-- ============================================================ Info (icon only) -->
            <TabItem x:Name="InfoTab" ToolTip="How this app works">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info24"/>
                        <!-- Empty title: keeps the chip as tall as the other tabs. -->
                        <TextBlock Style="{StaticResource TabTitle}" Width="0"/>
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <!-- ============================================================ Game controls -->
            <TabItem x:Name="GameTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <!-- Fill follows the tab's text colour (selected / hover / normal). -->
                        <Path Data="{StaticResource WheelGeometry}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,6,0"
                              VerticalAlignment="Center"
                              Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                        <TextBlock Text="GAME CONTROLS" Style="{StaticResource TabTitle}"/>
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <!-- ============================================================ RBRControls -->
            <TabItem x:Name="PluginTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PuzzlePiece24" Margin="0,0,6,0"/>
                        <TextBlock Text="RBR CONTROLS" Style="{StaticResource TabTitle}"/>
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <!-- ============================================================ Force feedback -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="VehicleCar24" Margin="0,0,6,0"/>
                        <TextBlock Text="FORCE FEEDBACK" Style="{StaticResource TabTitle}"/>
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <!-- ============================================================ Profiles (opened from the header) -->
            <TabItem x:Name="ProfilesPage" Visibility="Collapsed">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PeopleSettings24" Margin="0,0,6,0"/>
                        <TextBlock Text="Profiles"/>
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <!-- ============================================================ Settings (opened from the status bar) -->
            <TabItem x:Name="SettingsPage" Visibility="Collapsed">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" Margin="0,0,6,0"/>
                        <TextBlock Text="Settings"/>
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
        </TabControl>
        <local:InputDisplay x:Name="LiveInputs" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,2"/>
        </Grid>
        <Grid x:Name="Pages">
            <Border x:Name="InfoPage" Visibility="Collapsed">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel Margin="0,0,0,12" MaxWidth="900" HorizontalAlignment="Stretch">
                        <HeaderedContentControl Style="{StaticResource Section}">
                            <HeaderedContentControl.Header>
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="PeopleSettings24" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="APP PROFILES VS GAME PROFILES" Style="{StaticResource SectionHeading}"/>
                                </DockPanel>
                            </HeaderedContentControl.Header>
                            <StackPanel Margin="12,4,12,10">
                                <TextBlock Text="Game profile (RBR)" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource CardText}" Margin="0,2,0,10"
                                           Text="The player profile you create inside RBR. The game keeps its controls in SavedGames\pf&lt;PROFILE&gt;.acm. This app reads and writes the RBR profile you played last, or the one picked in Settings. Everything you edit here goes into that game profile."/>
                                <TextBlock Text="App profile" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource CardText}" Margin="0,2,0,10"
                                           Text="A named snapshot saved by this app: game bindings, axis inversion, RBRControls binds and force feedback values. It lives only in the app (%AppData%\RBRInputManager) until you apply it, which copies it into the game profile above (the game files are backed up first)."/>
                                <TextBlock Style="{StaticResource CardText}"
                                           Text="Use app profiles to keep several setups (a wheel, a gamepad, a different pedal set…) and switch between them from the selector in the header. When the game files no longer match the selected app profile, it shows as Modified: revert to write the profile back, or use Overwrite with current setup in Profiles to keep the new state."/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource Section}">
                            <HeaderedContentControl.Header>
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="Map24" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="CONTROL MAPS" Style="{StaticResource SectionHeading}"/>
                                </DockPanel>
                            </HeaderedContentControl.Header>
                            <StackPanel Margin="12,4,12,10">
                                <TextBlock Style="{StaticResource CardText}" Margin="0,2,0,10"
                                           Text="Inside each game profile RBR keeps one control map per set of connected controllers. A map remembers its exact list of devices, identified by the instance GUID Windows gives each one."/>
                                <TextBlock Text="Which map does RBR use?" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource CardText}" Margin="0,2,0,10"
                                           Text="When the game starts it looks for the map whose devices match exactly the controllers connected right now. If none matches (you plugged in a new device, unplugged one, used another USB port or Windows assigned a new GUID) RBR silently creates a new map with default bindings, and your old bindings seem lost."/>
                                <TextBlock Text="What the app does" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource CardText}"
                                           Text="Game controls lists every map and marks the active one (the one matching your current controllers). Picking an older map shows its bindings, and Copy to map moves them into the active map, onto the same devices (or the same model when the GUID changed). The Devices list shows which of a map's controllers are missing."/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="GamePage" Visibility="Visible">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource Section}">
                            <HeaderedContentControl.Header>
                                <DockPanel>
                                    <ComboBox x:Name="MapBox" DockPanel.Dock="Right" MinWidth="230" VerticalAlignment="Center"
                                              DisplayMemberPath="Label" SelectionChanged="MapBox_SelectionChanged"/>
                                    <CheckBox DockPanel.Dock="Right" x:Name="GameBoundOnlyBox" Content="Bound only"
                                              Margin="0,0,12,0" VerticalAlignment="Center" Click="GameBoundOnly_Click"/>
                                    <ui:SymbolIcon Symbol="Keyboard24" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="BINDINGS" Style="{StaticResource SectionHeading}"/>
                                    <TextBlock x:Name="BindingCountText" Style="{StaticResource SectionCount}"/>
                                </DockPanel>
                            </HeaderedContentControl.Header>
                            <StackPanel>
                                <!-- Full-bleed band: cancels the section padding (the grid's -2 top margin eats the bottom 2) -->
                                <Border x:Name="MapNotice" Style="{StaticResource Notice}" Visibility="Collapsed"
                                        Margin="-4,-2,-4,2" CornerRadius="0" BorderThickness="0" Padding="16,10">
                                    <DockPanel>
                                        <ui:Button x:Name="CopyMapButton" DockPanel.Dock="Right" Appearance="Secondary"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                                   Icon="{ui:SymbolIcon Copy24}" Click="CopyMap_Click"/>
                                        <ui:Button x:Name="AdaptMapButton" DockPanel.Dock="Right" Appearance="Secondary"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                                   Content="Use with these controllers"
                                                   Icon="{ui:SymbolIcon PlugConnected24}" Click="AdaptMap_Click"/>
                                        <Image Source="Assets/Warning.png" Width="24" Height="24" Margin="0,0,12,0"
                                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock x:Name="MapNoticeText" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </DockPanel>
                                </Border>
                                <DataGrid x:Name="GameGrid" RowStyle="{StaticResource BindingRow}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="200"/>
                                        <DataGridTemplateColumn Header="Device" CellTemplate="{StaticResource DeviceCell}" Width="250"/>
                                        <DataGridTextColumn Header="Input" Binding="{Binding Input}" Width="*" HeaderStyle="{StaticResource HeaderNoRightEdge}"/>
                                        <DataGridTemplateColumn Header="Inverted" CellTemplate="{StaticResource InvertCell}" Width="80" CanUserResize="False"
                                                                HeaderStyle="{StaticResource HeaderNoLeftEdge}"/>
                                        <DataGridTemplateColumn Header="" CellTemplate="{StaticResource GameEditCell}" Width="150" CanUserResize="False"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource Section}">
                            <HeaderedContentControl.Header>
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="UsbStick24" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="DEVICES" Style="{StaticResource SectionHeading}"/>
                                    <TextBlock x:Name="MapDeviceCountText" Style="{StaticResource SectionCount}"/>
                                </DockPanel>
                            </HeaderedContentControl.Header>
                            <DataGrid x:Name="ProfileDevicesGrid">
                                <DataGrid.GroupStyle>
                                    <StaticResource ResourceKey="Groups"/>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"/>
                                    <DataGridTemplateColumn Header="Device" CellTemplate="{StaticResource DeviceCell}" Width="280"/>
                                    <DataGridTextColumn Header="VID/PID" Binding="{Binding VidPid}" Width="160"/>
                                    <DataGridTextColumn Header="Instance GUID" Binding="{Binding Guid}" Width="*" HeaderStyle="{StaticResource HeaderNoRightEdge}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="PluginPagePanel" Visibility="Collapsed">
                <ScrollViewer Style="{StaticResource Page}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <HeaderedContentControl Style="{StaticResource Section}" VerticalAlignment="Top">
                            <HeaderedContentControl.Header>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" x:Name="OnlyBoundBox" Content="Bound only"
                                              IsChecked="True" VerticalAlignment="Center" Click="OnlyBound_Click"/>
                                    <ui:SymbolIcon Symbol="Keyboard24" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="PLUGIN BINDS" Style="{StaticResource SectionHeading}"/>
                                    <TextBlock x:Name="PluginCountText" Style="{StaticResource SectionCount}"/>
                                </DockPanel>
                            </HeaderedContentControl.Header>
                            <DataGrid x:Name="PluginGrid" RowStyle="{StaticResource BindingRow}">
                                <DataGrid.GroupStyle>
                                    <StaticResource ResourceKey="Groups"/>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Function" Binding="{Binding Function}" Width="220"/>
                                    <DataGridTemplateColumn Header="Device" CellTemplate="{StaticResource DeviceCell}" Width="*" MinWidth="120"
                                                            HeaderStyle="{StaticResource HeaderNoRightEdge}"/>
                                    <DataGridTextColumn Header="Input" Binding="{Binding Input}" Width="80" CanUserResize="False"
                                                        HeaderStyle="{StaticResource HeaderNoLeftEdge}"/>
                                    <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="90" CanUserResize="False"/>
                                    <DataGridTextColumn Header="Context" Binding="{Binding GameMode}" Width="95" CanUserResize="False"/>
                                    <DataGridTemplateColumn Header="" CellTemplate="{StaticResource PluginEditCell}" Width="110" CanUserResize="False"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </HeaderedContentControl>
                        <HeaderedContentControl Grid.Column="2" Style="{StaticResource Section}" VerticalAlignment="Top">
                            <HeaderedContentControl.Header>
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="Options24" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="PLUGIN OPTIONS" Style="{StaticResource SectionHeading}"/>
                                </DockPanel>
                            </HeaderedContentControl.Header>
                            <DataGrid x:Name="ShifterGrid">
                                <DataGrid.GroupStyle>
                                    <StaticResource ResourceKey="Groups"/>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Setting" Binding="{Binding Name}" Width="*" CanUserResize="False"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding GameValue}" Width="140" CanUserResize="False"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </HeaderedContentControl>
                    </Grid>
                </ScrollViewer>
            </Border>
            <Border x:Name="FfbPage" Visibility="Collapsed">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource Section}" Padding="16,14,16,12">
                            <HeaderedContentControl.Header>
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="Gauge24" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="IN-GAME STRENGTH" Style="{StaticResource SectionHeading}"/>
                                </DockPanel>
                            </HeaderedContentControl.Header>
                            <StackPanel>
                                <DockPanel>
                                    <ui:Button x:Name="StrengthFullButton" DockPanel.Dock="Right" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Appearance="Primary" Content="Set to 100%"
                                               Icon="{ui:SymbolIcon ArrowMaximize24}" Click="StrengthFull_Click"
                                               ToolTip="Write 100% to the in-game strength in the RBR profile"/>
                                    <TextBlock x:Name="StrengthText" DockPanel.Dock="Right" FontSize="28" FontWeight="SemiBold"
                                               MinWidth="90" TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Options → Controls → Force Feedback → Strength" Style="{StaticResource CardText}"
                                                   Margin="0,0,0,6"/>
                                        <!-- Read-only mirror of the game's slider; "Set to 100%" is the only way to change it here. -->
                                        <Slider x:Name="StrengthSlider" Style="{StaticResource StrengthBar}" Minimum="0" Maximum="100"
                                                IsHitTestVisible="False" Focusable="False" IsTabStop="False"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border x:Name="StrengthNotice" Style="{StaticResource Notice}" Margin="0,12,0,0">
                                    <DockPanel>
                                        <ui:SymbolIcon x:Name="StrengthNoticeIcon" Symbol="Warning24" FontSize="18" Margin="0,0,10,0"
                                                       VerticalAlignment="Top"/>
                                        <TextBlock x:Name="StrengthNoticeText" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource Section}">
                            <HeaderedContentControl.Header>
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="DocumentSettings20" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="GAME AND LAUNCHER SETTINGS" Style="{StaticResource SectionHeading}"/>
                                </DockPanel>
                            </HeaderedContentControl.Header>
                            <StackPanel>
                            <Border Style="{StaticResource InfoBanner}">
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="Info24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Top"
                                                   Foreground="#FF3D8BE0"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        This is a basic read-only view. To change these values use the original RSF launcher, or the third-party
                                        <Hyperlink NavigateUri="https://github.com/IvIePhisto/RsfRbrPowerSteering" RequestNavigate="Hyperlink_RequestNavigate"
                                                   FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}">RSF RBR Power Steering</Hyperlink>
                                        app.
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                            <DataGrid x:Name="FfbGrid" RowStyle="{StaticResource SettingRow}">
                                <DataGrid.GroupStyle>
                                    <StaticResource ResourceKey="Groups"/>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Setting" Binding="{Binding Name}" Width="250"/>
                                    <DataGridTextColumn Header="Game" Binding="{Binding GameValue}" Width="90"/>
                                    <DataGridTextColumn Header="RSF launcher" Binding="{Binding LauncherValue}" Width="110"/>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Source}" Width="290"/>
                                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" HeaderStyle="{StaticResource HeaderNoRightEdge}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="ProfilesPagePanel" Visibility="Collapsed">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource Section}" Padding="16,12">
                            <HeaderedContentControl.Header>
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="Save24" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="SAVE CURRENT SETUP" Style="{StaticResource SectionHeading}"/>
                                </DockPanel>
                            </HeaderedContentControl.Header>
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="Save" Appearance="Primary" Margin="8,0,0,0"
                                           Icon="{ui:SymbolIcon Save24}" Click="SaveProfile_Click"/>
                                <ui:TextBox x:Name="ProfileNameBox" PlaceholderText="Profile name, e.g. Simagic + SIMSONN"
                                            KeyDown="ProfileName_KeyDown"
                                            ToolTip="Stores the game bindings, axis inversion, RBRControls binds and force feedback values."/>
                            </DockPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource Section}">
                            <HeaderedContentControl.Header>
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="Folder24" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="SAVED PROFILES" Style="{StaticResource SectionHeading}"/>
                                    <TextBlock x:Name="ProfileCountText" Style="{StaticResource SectionCount}"/>
                                </DockPanel>
                            </HeaderedContentControl.Header>
                            <DockPanel>
                                <!-- Action strip, like the footer of a Windows flyout. -->
                                <Border DockPanel.Dock="Bottom" Margin="-4,4,-4,-4" Padding="16,10" CornerRadius="0,0,8,8"
                                        Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button x:Name="ApplyProfileButton" Content="Apply to game" Appearance="Primary"
                                                   Icon="{ui:SymbolIcon Play24}" Click="ApplyProfile_Click" IsEnabled="False"/>
                                        <ui:Button x:Name="UpdateProfileButton" Content="Overwrite with current setup" Margin="8,0,0,0"
                                                   Icon="{ui:SymbolIcon ArrowSync24}" Click="UpdateProfile_Click" IsEnabled="False"/>
                                        <ui:Button x:Name="DeleteProfileButton" Content="Delete" Margin="8,0,0,0"
                                                   Icon="{ui:SymbolIcon Delete24}" Click="DeleteProfile_Click" IsEnabled="False"/>
                                    </StackPanel>
                                </Border>
                                <Grid Margin="8" MinHeight="200">
                                    <ui:ListView x:Name="ProfileList" SelectionMode="Single" SelectionChanged="ProfileList_SelectionChanged">
                                        <ui:ListView.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="6,8">
                                                    <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0"
                                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                        <ui:SymbolIcon Symbol="XboxController24" FontSize="18"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                    </Border>
                                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource CardText}">
                                                        <Run Text="Saved"/> <Run Text="{Binding Updated, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="14"/>
                                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource CardText}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ui:ListView.ItemTemplate>
                                    </ui:ListView>
                                    <StackPanel x:Name="NoProfilesText" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="PeopleSettings24" FontSize="40" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="No profiles yet" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"
                                                   Margin="0,8,0,0"/>
                                        <TextBlock Text="Type a name above and save your current setup." Style="{StaticResource CardText}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="SettingsPagePanel" Visibility="Collapsed">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel Margin="0,0,0,12" MaxWidth="900" HorizontalAlignment="Stretch">
                        <TextBlock Text="General" Style="{StaticResource Caption}" Margin="2,0,0,8"/>
                        <ui:CardControl Icon="{ui:SymbolIcon Folder24}" Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="RBR install folder" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="SettingsPathText" Style="{StaticResource CardText}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Change…" Click="Browse_Click"/>
                        </ui:CardControl>

                        <ui:CardControl Icon="{ui:SymbolIcon Person24}" Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="RBR profile" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="SettingsProfileText" Style="{StaticResource CardText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="RbrProfileBox" MinWidth="170" SelectionChanged="RbrProfile_Changed"/>
                        </ui:CardControl>

                        <ui:CardControl Icon="{ui:SymbolIcon DarkTheme24}" Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="App theme" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Follow Windows or force light or dark mode." Style="{StaticResource CardText}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="ThemeBox" MinWidth="170" SelectionChanged="Theme_Changed">
                                <ComboBoxItem Content="Use Windows setting" Tag="System"/>
                                <ComboBoxItem Content="Light" Tag="Light"/>
                                <ComboBoxItem Content="Dark" Tag="Dark"/>
                            </ComboBox>
                        </ui:CardControl>

                        <ui:CardControl Icon="{ui:SymbolIcon CursorClick24}" Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Find bindings by pressing inputs" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="While this window is in front, pressing a button or key (or moving an axis) jumps to where it is bound."
                                               Style="{StaticResource CardText}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="LocateSwitch" Click="LocateSwitch_Click"/>
                        </ui:CardControl>

                        <TextBlock Text="Game files" Style="{StaticResource Caption}"/>
                        <ui:CardControl Icon="{ui:SymbolIcon History24}" Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Original game files" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="BackupText" Style="{StaticResource CardText}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Open folder" Click="OpenBackupFolder_Click" Margin="0,0,8,0"/>
                                <ui:Button x:Name="RestoreButton" Content="Restore originals" Icon="{ui:SymbolIcon ArrowUndo24}"
                                           Click="Restore_Click"/>
                            </StackPanel>
                        </ui:CardControl>

                        <TextBlock Text="About" Style="{StaticResource Caption}"/>
                        <ui:CardControl Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Updates" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="VersionText" Style="{StaticResource CardText}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click"/>
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        </DockPanel>

        <!-- Status bar: darker footer strip, like the bottom of a Windows flyout. -->
        <!-- Unsaved binding edits -->
        <Border x:Name="PendingBar" Grid.Row="4" Visibility="Collapsed" Margin="16,8,16,0" Padding="16,10" CornerRadius="8"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button x:Name="PendingChangesButton" Icon="{ui:SymbolIcon List24}" Click="ShowEdits_Click" Margin="0,0,8,0"
                               ToolTip="See what will be written to the game"/>
                    <ui:Button Content="Discard" Click="DiscardEdits_Click" Margin="0,0,8,0"/>
                    <ui:Button Content="Save to game" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Click="SaveEdits_Click"/>
                </StackPanel>
                <ui:SymbolIcon Symbol="Edit24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Unsaved changes to the bindings" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="  ·  the game files are backed up before saving" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="5" Margin="0,8,0,0" Padding="18,4,8,4"
                Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <!-- Version + update state, then the settings button. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="VersionButton" Appearance="Transparent" Padding="8,4" Click="Version_Click"
                               BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="UpdateDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="VersionLabel" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="SettingsButton" Appearance="Transparent" Padding="8,6" Margin="2,0,0,0"
                               BorderThickness="0" Click="OpenSettings_Click" ToolTip="Settings">
                        <ui:SymbolIcon x:Name="SettingsIcon" Symbol="Settings24" FontSize="16"/>
                    </ui:Button>
                </StackPanel>
                <ui:SymbolIcon Symbol="Info24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </DockPanel>
        </Border>
        <!-- Input capture: dims the window and waits for a button, key or axis. Esc cancels. -->
        <Grid x:Name="CaptureOverlay" Grid.RowSpan="6" Visibility="Collapsed" Panel.ZIndex="100" Focusable="True"
              Background="{DynamicResource SmokeFillColorDefaultBrush}">
            <Grid.Resources>
                <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity"
                                     From="0.25" To="1" Duration="0:0:0.8"/>
                    <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX"
                                     From="0.85" To="1.1" Duration="0:0:0.8"/>
                    <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY"
                                     From="0.85" To="1.1" Duration="0:0:0.8"/>
                </Storyboard>
            </Grid.Resources>
            <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="8" Padding="28,24"
                    Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Ellipse x:Name="PulseRing" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="3"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="PulseScale"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <ui:SymbolIcon Symbol="XboxController24" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                    <TextBlock x:Name="CaptureTitle" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="CaptureHint" Margin="0,8,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Esc to cancel" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <ui:Button Content="Cancel" HorizontalAlignment="Center" Margin="0,18,0,0" Click="CancelCapture_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
