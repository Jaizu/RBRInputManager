<Application x:Class="RBRInputManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:RBRInputManager"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Assets/Logo.xaml" />
                <ResourceDictionary Source="Assets/Wheel.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- TeX Gyre Heros Bold (free Helvetica/Swiss clone, GUST Font License), embedded from Assets/Fonts. -->
            <FontFamily x:Key="HudFont">pack://application:,,,/Assets/Fonts/#TeX Gyre Heros, Segoe UI</FontFamily>
            <!-- Tab names: upper case in the HUD font. -->
            <Style x:Key="TabTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource HudFont}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Tooltips: dark bubble beside, below or above the target with an arrow pointing at it (see TooltipPlacement). -->
            <SolidColorBrush x:Key="TooltipBackground" Color="#141414"/>
            <SolidColorBrush x:Key="TooltipBorder" Color="#3C3C3C"/>
            <Style TargetType="ToolTip">
                <Setter Property="Placement" Value="Custom"/>
                <Setter Property="CustomPopupPlacementCallback" Value="{x:Static local:TooltipPlacement.Callback}"/>
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="MaxWidth" Value="360"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <!--
                                Outer margin: room for the shadow (TooltipPlacement offsets by the same amount).
                                Bubble margin: room for the arrow on every side, so the size doesn't change with the side.
                                The arrows are open figures drawn over the bubble's border: filled, stroked on the two outer edges only.
                            -->
                            <Grid Margin="6" SnapsToDevicePixels="True">
                                <Grid.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.5"/>
                                </Grid.Effect>
                                <Border Margin="6" Background="{StaticResource TooltipBackground}" BorderBrush="{StaticResource TooltipBorder}"
                                        BorderThickness="1" CornerRadius="4" Padding="10,6">
                                    <ContentPresenter>
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </Border>
                                <!-- 8 px boxes: the base reaches 1 px into the bubble, covering its border there.
                                     TooltipPlacement moves them off centre when the bubble had to slide to fit. -->
                                <Path x:Name="ArrowLeft" Data="M7,0 L1,6 L7,12" Width="8" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Fill="{StaticResource TooltipBackground}" Stroke="{StaticResource TooltipBorder}"/>
                                <Path x:Name="ArrowRight" Data="M1,0 L7,6 L1,12" Width="8" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Fill="{StaticResource TooltipBackground}" Stroke="{StaticResource TooltipBorder}" Visibility="Collapsed"/>
                                <Path x:Name="ArrowUp" Data="M0,7 L6,1 L12,7" Width="12" Height="8" HorizontalAlignment="Center" VerticalAlignment="Top"
                                      Fill="{StaticResource TooltipBackground}" Stroke="{StaticResource TooltipBorder}" Visibility="Collapsed"/>
                                <Path x:Name="ArrowDown" Data="M0,1 L6,7 L12,1" Width="12" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                      Fill="{StaticResource TooltipBackground}" Stroke="{StaticResource TooltipBorder}" Visibility="Collapsed"/>
                            </Grid>
                            <!-- Side is where the bubble ended up relative to its target; the arrow points back at it. -->
                            <ControlTemplate.Triggers>
                                <Trigger Property="local:TooltipPlacement.Side" Value="Left">
                                    <Setter TargetName="ArrowLeft" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="ArrowRight" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="local:TooltipPlacement.Side" Value="Bottom">
                                    <Setter TargetName="ArrowLeft" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="ArrowUp" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="local:TooltipPlacement.Side" Value="Top">
                                    <Setter TargetName="ArrowLeft" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="ArrowDown" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
